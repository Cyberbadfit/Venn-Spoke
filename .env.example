# Copy to .env for local use. Never commit a production secret.
PORT=4000
# Required in production: a long random value (at least 32 characters).
JWT_SECRET=replace-this-with-a-long-random-production-secret
ADMIN_EMAIL=admin@nexora.local
# Required in production: use a unique, long password instead of a demo password.
ADMIN_PASSWORD=replace-with-a-unique-production-password
# Comma-separated frontend origins permitted to call the API.
CORS_ORIGIN=http://localhost:5173,https://vennspoken.vercel.app
